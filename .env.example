# Configuration for WhatsApp Spoofing Bot

# Telegram Bot Token (required for Telegram bot mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Example usage:
# 1. Create a bot on Telegram by messaging @BotFather
# 2. Copy the token and set it in this file
# 3. Run the application with -telegram flag: ./whats-spoofing-bot -telegram

# Database configuration (optional, defaults provided)
# DB_DIALECT=sqlite3
# DB_ADDRESS=file:db/whatsbot.db?_foreign_keys=on